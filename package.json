{
  "name": "telcoguard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @telcoguard/backend",
    "dev:frontend": "npm run dev -w @telcoguard/frontend",
    "dev:simulator": "npm run dev -w @telcoguard/simulator",
    "dev": "concurrently -n \"BACKEND,SIM\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:simulator\"",
    "db:generate": "npm run generate -w @telcoguard/backend",
    "db:push": "npm run push -w @telcoguard/backend",
    "db:seed": "npm run seed -w @telcoguard/backend"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
