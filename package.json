  "type": "module",
  "main": "eslint.config.js",
  "scripts": {
    "dev:backend": "npm run dev --workspace=@telcoguard/backend",
    "dev:simulator": "npm run dev --workspace=@telcoguard/simulator",
    "dev:frontend": "npm run dev --workspace=@telcoguard/frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:simulator\" \"npm run dev:frontend\"",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.3"
  },
  "workspaces": [
    "backend/*"
  ]
}
